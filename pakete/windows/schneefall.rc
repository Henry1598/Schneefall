// Windows-Ressourcen von schneefall.exe: Programm-Symbol und VERSIONINFO.
// Übersetzt per windres (siehe Makefile); VERSION_TEXT ("1.0.0") und VERSION_ZAHL (1,0,0,0) kommen aus der Datei VERSION.
#include <winver.h>

1 ICON "symbole/schneefall.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    VERSION_ZAHL
PRODUCTVERSION VERSION_ZAHL
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0407 = Deutsch, 04B0 = Unicode
        BLOCK "040704B0"
        BEGIN
            VALUE "CompanyName",      "Henry1598\0"
            VALUE "FileDescription",  L"Schneefall \x2013 Schnee auf dem Desktop\0"
            VALUE "FileVersion",      VERSION_TEXT "\0"
            VALUE "InternalName",     "schneefall\0"
            VALUE "OriginalFilename", "schneefall.exe\0"
            VALUE "ProductName",      "Schneefall\0"
            VALUE "ProductVersion",   VERSION_TEXT "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0407, 0x04B0
    END
END
